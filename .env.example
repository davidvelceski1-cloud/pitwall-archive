# Ask the Archive (optional). Without a key the assistant answers from the archive's
# own passages in "offline" mode — still grounded and cited, just not conversational.
ANTHROPIC_API_KEY=

# PostgreSQL (optional for running the site; required for `npm run db:push` / `db:seed`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitwall

# Public site URL, used for Open Graph and sitemap links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
